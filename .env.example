# ============================================================
# Astral Forge — copiez en .env et adaptez
# ============================================================
APP_NAME="Astral Forge"
APP_VERSION=0.4.1
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_CHARSET=UTF-8
APP_BASE_URL=

# Vite (astral-vite) — optionnel
# VITE_DEV_SERVER=http://localhost:5173
# VITE_BUILD_DIR=/build

DB_DRIVER=sqlite
DB_DATABASE=database/forge.sqlite

# AUTH_REGISTRATION=direct   # ou confirm (mailer)
AUTH_REGISTRATION=direct

# Racine autorisée pour les projets générés (défaut: parent de astral-forge = www)
# FORGE_ALLOWED_ROOT=D:\laragon\www
# FORGE_STARTER_PACKAGE=astral-php/astral-starter:^2.1
#
# Binaires create-project (vide = auto). Laragon dans le PATH suffit en général.
# Si Apache n’hérite pas du PATH : chemins absolus recommandés.
# FORGE_PHP_BIN=D:\laragon\bin\php\php-8.3.33-Win32-vs16-x64\php.exe
# FORGE_COMPOSER_BIN=D:\laragon\bin\composer\composer.phar
# Linux : FORGE_COMPOSER_BIN=/usr/local/bin/composer
# Apache Windows : laisser à 0 (CLI). 1 = tenter create-project depuis le web (expérimental).
# FORGE_ALLOW_APACHE_COMPOSER=0


MAIL_DRIVER=mail
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME="Astral Forge"
