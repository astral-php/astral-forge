# ============================================================
# Astral Forge — copiez en .env ou lancez : composer forge:env
# ============================================================
APP_NAME="Astral Forge"
APP_VERSION=0.6.1
# production = assets /build (UI locale sans `npm run dev`)
# development = Vite :5173 (nécessite `npm run dev`)
APP_ENV=production
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_CHARSET=UTF-8
APP_BASE_URL=
APP_URL=

# Vite (astral-vite) — optionnel en développement seulement
# VITE_DEV_SERVER=http://localhost:5173
# VITE_BUILD_DIR=/build

DB_DRIVER=sqlite
DB_DATABASE=database/forge.sqlite

# AUTH_REGISTRATION=direct   # ou confirm (mailer)
AUTH_REGISTRATION=direct

# Racine autorisée pour les projets générés (défaut forge:env = parent de astral-forge)
# Win Laragon ex. : D:\laragon\www
# Linux ex. : /home/user/www
FORGE_ALLOWED_ROOT=
# FORGE_STARTER_PACKAGE=astral-php/astral-starter:^2.1

# Binaires create-project — `composer forge:env` les détecte (OS).
# Win Laragon :
# FORGE_PHP_BIN=D:\laragon\bin\php\php-8.3.33-Win32-vs16-x64\php.exe
# FORGE_COMPOSER_BIN=D:\laragon\bin\composer\composer.phar
# Linux :
# FORGE_PHP_BIN=/usr/bin/php8.3
# FORGE_COMPOSER_BIN=/usr/local/bin/composer
FORGE_PHP_BIN=
FORGE_COMPOSER_BIN=

# Apache Windows : 0 (CLI / job async). Linux FPM/nginx : 1 souvent OK.
FORGE_ALLOW_APACHE_COMPOSER=0

MAIL_DRIVER=mail
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME="Astral Forge"
