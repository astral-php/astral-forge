# ============================================================
# Astral Forge — copiez en .env et adaptez
# ============================================================
APP_NAME="Astral Forge"
APP_VERSION=0.2.0
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_CHARSET=UTF-8
APP_BASE_URL=

DB_DRIVER=sqlite
DB_DATABASE=database/forge.sqlite

# AUTH_REGISTRATION=direct   # ou confirm (mailer)
AUTH_REGISTRATION=direct

# Racine autorisée pour les projets générés (défaut: parent de astral-forge = www)
# FORGE_ALLOWED_ROOT=D:\laragon\www
# FORGE_STARTER_PACKAGE=astral-php/astral-starter:^2.1
# FORGE_COMPOSER_BIN=composer

MAIL_DRIVER=mail
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME="Astral Forge"
